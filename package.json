{
  "name": "salut-french-uz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Voilà! — fransuz tilini o'zbek tilida o'rganish ilovasi",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "server": "node --env-file-if-exists=.env --watch server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "ai:on": "node --env-file-if-exists=.env server/ai-switch.ts on",
    "ai:off": "node --env-file-if-exists=.env server/ai-switch.ts off",
    "ai:status": "node --env-file-if-exists=.env server/ai-switch.ts status"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.18"
  }
}
