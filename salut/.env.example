# Salut! serveri — haqiqiy qiymatlarni faqat serverda saqlang, repoga yozmang.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Tabiiy ovoz (ElevenLabs).
#   eleven_v4 — o'zbek tilini qo'llaydi va [laughs] kabi hissiyot teglarini tushunadi (tavsiya).
#   eleven_v3 — o'zbek tilini QO'LLAMAYDI (ElevenLabs "unsupported_language" qaytaradi).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4
# Ixtiyoriy: tilni majburlash (masalan uz). Bo'sh — model o'zi aniqlaydi (fransuzcha qismlar uchun yaxshiroq).
ELEVENLABS_LANGUAGE_CODE=
